{
  "info": {
    "_postman_id": "123456789",
    "name": "Custosell API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"newtest@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost/custosell/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "path": [
                "custosell",
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login to the API and get an authentication token"
          },
          "response": []
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"New User\",\n    \"email\": \"newuser@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost/custosell/api/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "path": [
                "custosell",
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register a new user"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost/custosell/api/auth/logout",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "path": [
                "custosell",
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Log out the user and invalidate the token"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically save the token from login response",
          "if (pm.response.code === 200 && pm.info.requestName === \"Login\") {",
          "    var jsonData = pm.response.json();",
          "    if (jsonData.data && jsonData.data.token) {",
          "        pm.collectionVariables.set(\"token\", jsonData.data.token);",
          "        console.log(\"Token saved!\");",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
